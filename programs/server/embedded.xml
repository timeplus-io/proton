      <metadata_keep_versions>10</metadata_keep_versions>
      <metadata_max_retries>10</metadata_max_retries>
      <data_dirs>./proton-data/metastore/</data_dirs>
      <log>
        <check_crcs>false</check_crcs>
        <retention_check_ms>30000</retention_check_ms>
