        <timestamp_index_log_size>8388608</timestamp_index_log_size>
        <timestamp_index_log_preallocate>true</timestamp_index_log_preallocate>
        <log_position_index_log_size>8388608</log_position_index_log_size>
        <log_position_index_log_preallocate>true</log_position_index_log_preallocate>
      </log>
    </metastore>
  </metadata>
  <data>
    <datastore>
      <data_dirs>./proton-data/nativelog/</data_dirs>
      <log>
        <check_crcs>false</check_crcs>
        <retention_check_ms>300000</retention_check_ms>
        <fetch_max_wait_ms>500</fetch_max_wait_ms>
        <fetch_max_bytes>65536</fetch_max_bytes>
