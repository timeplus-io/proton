    <log_max_entry_size>10485760</log_max_entry_size>
    <log_max_cached_entries>0</log_max_cached_entries>
    <log_flush_interval_entries>1</log_flush_interval_entries>
    <log_flush_bytes>1</log_flush_bytes>
    <log_retention_size>1</log_retention_size>
