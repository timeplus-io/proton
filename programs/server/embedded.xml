        <fetch_max_bytes>65536</fetch_max_bytes>
        <max_entry_size>1048576</max_entry_size>
        <segment_size>10485760</segment_size>
        <retention_size>1</retention_size>
        <retention_ms>86400000</retention_ms>
        <min_size_to_keep>1</min_size_to_keep>
        <index_interval_bytes>4294967296</index_interval_bytes>
        <index_interval_entries>100000000</index_interval_entries>
        <flush_interval_ms>120000</flush_interval_ms>
        <flush_interval_entries>1</flush_interval_entries>
        <flush_bytes>1</flush_bytes>
        <compression_codec>none</compression_codec>
