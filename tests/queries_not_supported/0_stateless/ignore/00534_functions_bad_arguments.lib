#!/usr/bin/env bash

function test_variant {
    local query_template="$1"
    local function_name
    local query

    while IFS= read -r function_name; do
        query="${query_template//\$_/$function_name}"
        printf '%s\n' "$query"
    done < <($CLICKHOUSE_CLIENT -q "SELECT name FROM system.functions ORDER BY name;") \
        | $CLICKHOUSE_CLIENT --calculate_text_stack_trace=0 -n --ignore-error >/dev/null 2>&1

    $CLICKHOUSE_CLIENT -q "SELECT 'Still alive'"
}
