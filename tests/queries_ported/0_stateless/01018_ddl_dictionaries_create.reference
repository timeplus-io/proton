=DICTIONARY in Memory DB
CREATE DICTIONARY memory_db.dict2\n(\n  `key_column` uint64 DEFAULT 0 INJECTIVE,\n  `second_column` uint8 DEFAULT 1 EXPRESSION rand() % 222,\n  `third_column` string DEFAULT \'qqq\'\n)\nPRIMARY KEY key_column\nSOURCE(TIMEPLUS(HOST \'localhost\' PORT tcp_port() USER \'default\' STREAM \'table_for_dict\' PASSWORD \'[HIDDEN]\' DB \'database_for_dict_01018\'))\nLIFETIME(MIN 1 MAX 10)\nLAYOUT(FLAT())
dict2
1
memory_db	dict2
