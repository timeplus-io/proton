CREATE MATERIALIZED VIEW default.`99023_v`\n(\n  `start` datetime64(3, \'UTC\'),\n  `end` datetime64(3, \'UTC\'),\n  `avg(speed)` float64,\n  `_tp_time` datetime64(3, \'UTC\') DEFAULT now64(3, \'UTC\'),\n  `_tp_sn` int64\n) AS\nSELECT\n  window_start AS start, window_end AS end, avg(speed)\nFROM\n  session(default.`99023_speed`, 1m, [speed > 50, speed < 50))\nGROUP BY\n  window_start, window_end
CREATE MATERIALIZED VIEW default.`99023_v2`\n(\n  `start` datetime64(3, \'UTC\'),\n  `end` datetime64(3, \'UTC\'),\n  `avg(speed)` float64,\n  `_tp_time` datetime64(3, \'UTC\') DEFAULT now64(3, \'UTC\'),\n  `_tp_sn` int64\n) AS\nSELECT\n  window_start AS start, window_end AS end, avg(speed)\nFROM\n  session(default.`99023_speed`, 1m, speed > 50, speed < 50)\nGROUP BY\n  window_start, window_end
