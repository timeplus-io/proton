CREATE STREAM default.user_events\n(\n  `user_id` uint64,\n  `event_type` string,\n  `event_date` date,\n  `event_time` datetime,\n  `payload` string,\n  `_tp_time` datetime64(3, \'UTC\') DEFAULT now64(3, \'UTC\') CODEC(DoubleDelta, ZSTD(1)),\n  `_tp_sn` int64 CODEC(Delta(8), ZSTD(1)),\n  INDEX event_type_idx event_type TYPE minmax GRANULARITY 4,\n  INDEX _tp_time_index _tp_time TYPE minmax GRANULARITY 32,\n  INDEX _tp_sn_index _tp_sn TYPE minmax GRANULARITY 32\n)\nENGINE = Stream(1, rand())\nPARTITION BY to_YYYYMM(event_date)\nORDER BY (user_id, event_time)\nSETTINGS index_granularity = 8192
Now rename the column `event_type` to `action_name`
CREATE STREAM default.user_events\n(\n  `user_id` uint64,\n  `action_name` string,\n  `event_date` date,\n  `event_time` datetime,\n  `payload` string,\n  `_tp_time` datetime64(3, \'UTC\') DEFAULT now64(3, \'UTC\') CODEC(DoubleDelta, ZSTD(1)),\n  `_tp_sn` int64 CODEC(Delta(8), ZSTD(1)),\n  INDEX event_type_idx action_name TYPE minmax GRANULARITY 4,\n  INDEX _tp_time_index _tp_time TYPE minmax GRANULARITY 32,\n  INDEX _tp_sn_index _tp_sn TYPE minmax GRANULARITY 32\n)\nENGINE = Stream(1, rand())\nPARTITION BY to_YYYYMM(event_date)\nORDER BY (user_id, event_time)\nSETTINGS index_granularity = 8192
