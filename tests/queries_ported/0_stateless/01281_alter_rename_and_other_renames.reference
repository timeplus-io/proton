CREATE STREAM default.rename_table_multiple\n(\n  `key` int32,\n  `value1_string` string,\n  `value2` int32\n)\nENGINE = MergeTree\nORDER BY tuple_cast()\nSETTINGS min_bytes_for_wide_part = 0, index_granularity = 8192
key	value1_string	value2
