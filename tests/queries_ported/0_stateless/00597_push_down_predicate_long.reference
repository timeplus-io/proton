SELECT
  value + t1.value AS expr
FROM
  (
    SELECT
      t0.value, t1.value
    FROM
      test_00597 AS t0
    ALL FULL OUTER JOIN test_00597 AS t1 USING (date)
    WHERE
      (value + t1.`t1.value`) < 3
  )
WHERE
  expr < 3
