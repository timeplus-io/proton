{
    "test_suite_name": "seek_to_event_time_predicate",
    "comments": "Verifies that time-based seek_to injects an event-time predicate to bound the historical backfill scan, preventing the query from hanging on streams with large TTL (issue #558).",
    "test_suite_config": {
        "table_schemas": [
            {
                "name": "test_seek_to_predicate",
                "type": "table",
                "columns": [
                    {
                        "name": "id",
                        "type": "uint32"
                    },
                    {
                        "name": "value",
                        "type": "float64"
                    },
                    {
                        "name": "timestamp",
                        "type": "datetime64(3)",
                        "default": "now64(3)"
                    }
                ],
                "event_time_column": "timestamp"
            }
        ],
        "tests_2_run": {
            "ids_2_run": ["all"],
            "tags_2_run": [],
            "tags_2_skip": {
                "default": ["todo", "bug"]
            }
        }
    },

    "tests": [
        {
            "id": 0,
            "tags": ["seek_to", "event_time_predicate"],
            "name": "time-based seek_to with backfill should return only data within seek window",
            "description": "When using seek_to='-30s', the query should inject a _tp_time >= predicate so that the historical backfill only scans data within the seek window, not the entire MergeTree. This test inserts data with server-assigned timestamps (near 'now'), then runs a streaming query with seek_to to verify all recently-inserted data is returned.",
            "steps": [
                {
                    "inputs": [
                        {
                            "table_name": "test_seek_to_predicate",
                            "wait": 2,
                            "columns": ["id", "value"],
                            "data": [
                                [1, 100.0],
                                [2, 200.0],
                                [3, 300.0]
                            ]
                        }
                    ]
                },
                {
                    "statements": [
                        {
                            "client": "python",
                            "query_id": "seek_to_001",
                            "query_type": "stream",
                            "query_end_timer": 3,
                            "query": "select id, value from test_seek_to_predicate settings seek_to='-30s'"
                        }
                    ]
                }
            ],
            "expected_results": [
                {
                    "query_id": "seek_to_001",
                    "expected_results": [
                        [1, 100.0],
                        [2, 200.0],
                        [3, 300.0]
                    ]
                }
            ]
        }
    ]
}
